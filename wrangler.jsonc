{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-anki",
  "main": "worker/index.ts",
  "account_id": "d85f2d6c752e8056999b210d5cf48586",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers Assets: serve SPA from ./dist/client after `npm run build`.
  // vite outputs client SPA to dist/client and worker bundle to dist/my_anki;
  // pointing here at ./dist would expose the worker bundle (incl. .dev.vars) as static assets.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // D1: structured data
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myanki-db",
      "database_id": "494eb86f-7174-4a05-90d1-09ae121ac0ec",
      "migrations_dir": "migrations"
    }
  ],

  // R2: media (sha256-keyed)
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "myanki-media"
    }
  ],

  "observability": {
    "enabled": true
  }
}
